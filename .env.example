# Fake values for local development only. scripts/dev.py copies this to .env
# (which is git-ignored) and generates random secret keys.
# Never put real secrets in this file.
APP_ENV=development
DJANGO_SECRET_KEY=fake-dev-only-secret-key
JWT_COMPANY_SECRET=fake-dev-only-company-signing-secret-0001
JWT_ADMIN_SECRET=fake-dev-only-admin-signing-secret-00002
# Keys that encrypt candidate contact details and make them searchable by hash. They must
# be different from each other and from every other key.
FIELD_ENCRYPTION_KEY=fake-dev-only-field-encryption-key-0003
FIELD_HASH_KEY=fake-dev-only-field-hash-key-000000004
# Three database accounts (docs/security/database.md). The running app uses DATABASE_URL and
# cannot change the structure; `migrate` uses MIGRATION_DATABASE_URL; backups use the third.
# Staging and production add ?sslmode=verify-full so the connection is encrypted.
DATABASE_URL=postgres://bera_app:fake-dev-app-password@127.0.0.1:5432/bera
MIGRATION_DATABASE_URL=postgres://bera_migrator:fake-dev-migrator-password@127.0.0.1:5432/bera
BACKUP_DATABASE_URL=postgres://bera_backup:fake-dev-backup-password@127.0.0.1:5432/bera
# Development only: pretend the visitor is in this country on the sign-up form (there is no
# Cloudflare locally). Staging and production ignore it.
# DEVELOPMENT_PRETEND_COUNTRY=PK
# System emails. In development nothing is sent: messages are saved in .dev-inbox/.
EMAIL_FROM_ADDRESS=bera@example.test
WEB_BASE_URL=http://localhost:3000
# Required in staging and production (SMTP account of the email provider, https website
# address for links, the sender address; the password is a secret):
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=fake-smtp-user
# EMAIL_HOST_PASSWORD=
# Required in staging and production (comma separated host names):
# ALLOWED_HOSTS=staging.example.com
# ALLOWED_ORIGINS=https://staging.example.com
# How many proxies of ours sit in front of the server (used to find the real visitor address):
# TRUSTED_PROXY_COUNT=1

# Local database. The administrator account below only creates the three accounts above
# (Docker creates it with this password; with a native install use your own).
POSTGRES_DB=bera
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=fake-dev-admin-password

# Where the web app forwards /api requests.
API_URL=http://127.0.0.1:8000
