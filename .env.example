# Fake values for local development only. scripts/dev.py copies this to .env
# (which is git-ignored) and generates random secret keys.
# Never put real secrets in this file.
APP_ENV=development
DJANGO_SECRET_KEY=fake-dev-only-secret-key
JWT_COMPANY_SECRET=fake-dev-only-company-signing-secret-0001
JWT_ADMIN_SECRET=fake-dev-only-admin-signing-secret-00002
# Keys that encrypt candidate contact details and make them searchable by hash. They must
# be different from each other and from every other key.
FIELD_ENCRYPTION_KEY=fake-dev-only-field-encryption-key-0003
FIELD_HASH_KEY=fake-dev-only-field-hash-key-000000004
# Three database accounts (docs/security/database.md). The running app uses DATABASE_URL and
# cannot change the structure; `migrate` uses MIGRATION_DATABASE_URL; backups use the third.
# Staging and production add ?sslmode=verify-full so the connection is encrypted.
DATABASE_URL=postgres://bera_app:fake-dev-app-password@127.0.0.1:5432/bera
MIGRATION_DATABASE_URL=postgres://bera_migrator:fake-dev-migrator-password@127.0.0.1:5432/bera
BACKUP_DATABASE_URL=postgres://bera_backup:fake-dev-backup-password@127.0.0.1:5432/bera
# Development only: pretend the visitor is in this country on the sign-up form (there is no
# Cloudflare locally). Staging and production ignore it.
# DEVELOPMENT_PRETEND_COUNTRY=PK
# System emails. In development nothing is sent: messages are saved in .dev-inbox/.
EMAIL_FROM_ADDRESS=bera@example.test
WEB_BASE_URL=http://localhost:3000
# The website's public address, only for the sitemap, canonical and sharing links (never for security
# decisions). Production requires https and no trailing slash, or the web app will not build or start.
# NEXT_PUBLIC_SITE_URL=https://bera.example.com
# Required in staging and production (SMTP account of the email provider, https website
# address for links, the sender address; the password is a secret):
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=fake-smtp-user
# EMAIL_HOST_PASSWORD=
# Required in staging and production (the AI provider key; without it AI features fall back
# to manual entry):
# OPENAI_API_KEY=
# Required in staging and production (the payment provider's secret key; a TEST-mode key only,
# for example one that starts with sk_test_; real keys are refused until real payments are built):
# STRIPE_SECRET_KEY=
# Required in staging and production (signs the payment provider's notifications to
# /api/payments/stripe/webhook/; it starts with whsec_):
# STRIPE_WEBHOOK_SECRET=
# Required in staging and production (the private Cloudflare R2 bucket for uploaded files;
# in development files go to a private local folder instead):
# R2_ACCOUNT_ID=fake-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=fake-bucket-name
# Backups (BERA-178). Production requires all of these; in development the backup goes to the
# local folder .dev-backups (git-ignored) unless BACKUP_R2_BUCKET is set. The key must be at
# least 32 characters (python -c "import secrets; print(secrets.token_urlsafe(48))").
BACKUP_ENCRYPTION_KEY_ID=k1
BACKUP_ENCRYPTION_KEY=fake-dev-only-backup-encryption-key-0005
# RESTORE_TEST_DATABASE_URL=postgres://fake-user:fake-password@127.0.0.1:5432/postgres
# BACKUP_PREVIOUS_KEYS=k0=<an older key>
# BACKUP_R2_BUCKET=fake-backup-bucket-name
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# Heartbeat pings to an outside dead-man service such as Healthchecks.io (BERA-180). Production
# requires both; staging may set its own HEARTBEAT_URL. Each address is a secret. Development: unset.
# HEARTBEAT_URL=https://hc-ping.example.com/fake-health-check
# BACKUP_HEARTBEAT_URL=https://hc-ping.example.com/fake-backup-check
# Required in staging and production (comma separated host names):
# ALLOWED_HOSTS=staging.example.com
# ALLOWED_ORIGINS=https://staging.example.com
# Staging only: where its emails are saved (staging sends no real email and must have no
# EMAIL_HOST, EMAIL_HOST_USER or EMAIL_HOST_PASSWORD). Production must not set this.
# STAGING_EMAIL_FOLDER=/srv/bera/staging/data/emails
# Production only, and only after the owner decides to take real payments (BERA-170): allows live
# payment keys. Staging refuses it. Leave it out for test mode.
# STRIPE_ALLOW_LIVE_KEYS=true
# Deployment (see deploy/): the local ports of this environment's API and web processes, and how
# many background processes to run.
# API_PORT=8001
# WEB_PORT=3001
# Q_CLUSTER_WORKERS=1
# How many proxies of ours sit in front of the server (used to find the real visitor address):
# TRUSTED_PROXY_COUNT=1

# Local database. The administrator account below only creates the three accounts above
# (Docker creates it with this password; with a native install use your own).
POSTGRES_DB=bera
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=fake-dev-admin-password

# Where uploaded CVs are kept until Private file storage exists (default: local_storage/).
# PRIVATE_FILES_ROOT=

# Where the web app forwards /api requests.
API_URL=http://127.0.0.1:8000
