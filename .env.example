# Fake values for local development only. scripts/dev.py copies this to .env
# (which is git-ignored) and generates a random DJANGO_SECRET_KEY.
# Never put real secrets in this file.
APP_ENV=development
DJANGO_SECRET_KEY=fake-dev-only-secret-key
JWT_COMPANY_SECRET=fake-dev-only-company-signing-secret-0001
JWT_ADMIN_SECRET=fake-dev-only-admin-signing-secret-00002
DATABASE_URL=postgres://bera:fake-dev-db-password@127.0.0.1:5432/bera
# Required in staging and production (comma separated host names):
# ALLOWED_HOSTS=staging.example.com
# ALLOWED_ORIGINS=https://staging.example.com
# How many proxies of ours sit in front of the server (used to find the real visitor address):
# TRUSTED_PROXY_COUNT=1

# Local database (used by docker-compose.yml and the native PostgreSQL setup).
POSTGRES_USER=bera
POSTGRES_PASSWORD=fake-dev-db-password
POSTGRES_DB=bera
POSTGRES_PORT=5432
# Native PostgreSQL only: an account allowed to create the database above.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# Where the web app forwards /api requests.
API_URL=http://127.0.0.1:8000
