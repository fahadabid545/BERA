# Production environment file (fake example values). Copy to /etc/bera/production.env on the server,
# replace every value, owner = the service user, mode 600. Never commit the real file.
APP_ENV=production
API_PORT=8002
WEB_PORT=3002
API_URL=http://127.0.0.1:8002
ALLOWED_HOSTS=www.example.com
ALLOWED_ORIGINS=https://www.example.com
WEB_BASE_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Two proxies in front: Cloudflare and nginx (BERA-179). Only Cloudflare can reach the server, so
# the country header it adds can be trusted; with a wrong number the app trusts the wrong entry.
TRUSTED_PROXY_COUNT=2
DJANGO_SECRET_KEY=fake-production-django-secret-key-replace-me
JWT_COMPANY_SECRET=fake-production-company-signing-secret-replace-me
JWT_ADMIN_SECRET=fake-production-admin-signing-secret-replace-me
FIELD_ENCRYPTION_KEY=fake-production-field-encryption-key-replace-me
FIELD_HASH_KEY=fake-production-field-hash-key-replace-me
# Separate database, accounts and passwords per environment (the same server is fine).
DATABASE_URL=postgres://bera_production_app:fake-production-app-password@127.0.0.1:5432/bera_production?sslmode=require
MIGRATION_DATABASE_URL=postgres://bera_production_migrator:fake-production-migrator-password@127.0.0.1:5432/bera_production?sslmode=require
BACKUP_DATABASE_URL=postgres://bera_production_backup:fake-production-backup-password@127.0.0.1:5432/bera_production?sslmode=require
EMAIL_FROM_ADDRESS=bera-production@example.com
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=fake-smtp-user
EMAIL_HOST_PASSWORD=fake-production-smtp-password-replace-me
OPENAI_API_KEY=fake-production-openai-key-replace-me
# Test-mode keys only. Real keys need STRIPE_ALLOW_LIVE_KEYS=true in production, which the owner
# sets only after the tax decision (BERA-170). Staging never accepts real keys or that flag.
STRIPE_SECRET_KEY=sk_test_fake_production_key_replace_me
STRIPE_WEBHOOK_SECRET=whsec_fake_production_secret_replace_me
R2_ACCOUNT_ID=fake-account-id
R2_ACCESS_KEY_ID=fake-production-r2-key-id-replace-me
R2_SECRET_ACCESS_KEY=fake-production-r2-secret-replace-me
R2_BUCKET=fake-bera-production-bucket
# Backups (BERA-178): a second, separate bucket with its own access key, an encryption key kept
# offline as well, and an account allowed to create (only) throwaway databases for the weekly
# restore test. Production only.
BACKUP_R2_BUCKET=fake-bera-production-backups
BACKUP_R2_ACCESS_KEY_ID=fake-production-backup-r2-key-id-replace-me
BACKUP_R2_SECRET_ACCESS_KEY=fake-production-backup-r2-secret-replace-me
BACKUP_ENCRYPTION_KEY_ID=k1
BACKUP_ENCRYPTION_KEY=fake-production-backup-encryption-key-replace-me
# After a key change: BACKUP_PREVIOUS_KEYS=k1=<the old key>  (so older backups still open)
RESTORE_TEST_DATABASE_URL=postgres://bera_restore_test:fake-production-restore-test-password@127.0.0.1:5432/postgres?sslmode=require
