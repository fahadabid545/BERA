# Staging environment file (fake example values). Copy to /etc/bera/staging.env on the server,
# replace every value, owner = the service user, mode 600. Never commit the real file.
APP_ENV=staging
API_PORT=8001
WEB_PORT=3001
API_URL=http://127.0.0.1:8001
ALLOWED_HOSTS=staging.example.com
ALLOWED_ORIGINS=https://staging.example.com
WEB_BASE_URL=https://staging.example.com
NEXT_PUBLIC_SITE_URL=https://staging.example.com
# Two proxies in front: Cloudflare and nginx (BERA-179). Only Cloudflare can reach the server, so
# the country header it adds can be trusted; with a wrong number the app trusts the wrong entry.
TRUSTED_PROXY_COUNT=2
DJANGO_SECRET_KEY=fake-staging-django-secret-key-replace-me
JWT_COMPANY_SECRET=fake-staging-company-signing-secret-replace-me
JWT_ADMIN_SECRET=fake-staging-admin-signing-secret-replace-me
FIELD_ENCRYPTION_KEY=fake-staging-field-encryption-key-replace-me
FIELD_HASH_KEY=fake-staging-field-hash-key-replace-me
# Separate database, accounts and passwords per environment (the same server is fine).
DATABASE_URL=postgres://bera_staging_app:fake-staging-app-password@127.0.0.1:5432/bera_staging?sslmode=require
MIGRATION_DATABASE_URL=postgres://bera_staging_migrator:fake-staging-migrator-password@127.0.0.1:5432/bera_staging?sslmode=require
BACKUP_DATABASE_URL=postgres://bera_staging_backup:fake-staging-backup-password@127.0.0.1:5432/bera_staging?sslmode=require
EMAIL_FROM_ADDRESS=bera-staging@example.com
# Staging sends no real email: messages are saved here (list_staging_emails shows them).
# It must have NO EMAIL_HOST, EMAIL_HOST_USER or EMAIL_HOST_PASSWORD.
STAGING_EMAIL_FOLDER=/srv/bera/staging/data/emails
OPENAI_API_KEY=fake-staging-openai-key-replace-me
# Test-mode keys only. Real keys need STRIPE_ALLOW_LIVE_KEYS=true in production, which the owner
# sets only after the tax decision (BERA-170). Staging never accepts real keys or that flag.
STRIPE_SECRET_KEY=sk_test_fake_staging_key_replace_me
STRIPE_WEBHOOK_SECRET=whsec_fake_staging_secret_replace_me
R2_ACCOUNT_ID=fake-account-id
R2_ACCESS_KEY_ID=fake-staging-r2-key-id-replace-me
R2_SECRET_ACCESS_KEY=fake-staging-r2-secret-replace-me
R2_BUCKET=fake-bera-staging-bucket
# Optional in staging (BERA-180): its own check at the outside service, never production's.
# HEARTBEAT_URL=https://hc-ping.example.com/fake-staging-health-check-replace-me
